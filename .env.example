# Replace these example IDs with your actual GCP project IDs.
GOOGLE_CLOUD_PROJECT=YOUR_PROJECT_ID
BQ_DATA_PROJECT=YOUR_DATA_PROJECT_ID
BQ_SEMANTIC_DATASET=semantic_layer
# Must match the BigQuery dataset location.
BQ_LOCATION=EU
BQ_MAX_BYTES_BILLED=1000000000
BQ_MAX_ROWS=100
BQ_TIMEOUT_SECONDS=30

# Optional: override the default Windows gcloud ADC file location.
# Use forward slashes. Store only the path here, never credential contents.
# ADC_CREDENTIALS_PATH=C:/Users/YOUR_USER/AppData/Roaming/gcloud/application_default_credentials.json
